@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inherits LoginBase

@* Static server-rendered page (no interactive render mode) so the form posts
   run in a real HTTP request and can write the auth cookie. *@

<div class="auth-page">
    <div class="auth-brand">
        <div class="brand-mark">C</div>
        <h1 class="brand-title">Circles</h1>
        <p class="brand-tagline">Cirklar för din förening</p>
    </div>

    @if (Error == "1")
    {
        <p class="alert alert-error" role="alert">Fel e-post eller lösenord.</p>
    }
    else if (Error == "2")
    {
        <p class="alert alert-error" role="alert">Länken kunde inte användas. Be om en ny.</p>
    }
    else if (Error == "external_not_found")
    {
        <p class="alert alert-error" role="alert">
            Inget Circles-konto hittades@(string.IsNullOrWhiteSpace(Email) ? "" : $" för {Email}").
            Kontakta din administratör.
        </p>
    }
    else if (Error == "external")
    {
        <p class="alert alert-error" role="alert">Inloggningen med extern leverantör misslyckades. Försök igen.</p>
    }

    @* ---- External providers (Google / Microsoft) ---- *@
    @if (ExternalAuth.GoogleEnabled || ExternalAuth.MicrosoftEnabled)
    {
        <div class="social-login">
            @if (ExternalAuth.GoogleEnabled)
            {
                <a href="/auth/external-login?provider=Google" class="btn-social btn-google">
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.71-1.57 2.68-3.89 2.68-6.62z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.85.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
                        <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.47.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
                    </svg>
                    Logga in med Google
                </a>
            }
            @if (ExternalAuth.MicrosoftEnabled)
            {
                <a href="/auth/external-login?provider=Microsoft" class="btn-social btn-microsoft">
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                        <rect x="0" y="0" width="8.5" height="8.5" fill="#F25022"/>
                        <rect x="9.5" y="0" width="8.5" height="8.5" fill="#7FBA00"/>
                        <rect x="0" y="9.5" width="8.5" height="8.5" fill="#00A4EF"/>
                        <rect x="9.5" y="9.5" width="8.5" height="8.5" fill="#FFB900"/>
                    </svg>
                    Logga in med Microsoft
                </a>
            }
        </div>

        <div class="divider"><span>eller</span></div>
    }

    @* ---- Password login ---- *@
    <form method="post" action="/auth/login" class="auth-form">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="field">
            <label for="email">E-post</label>
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="namn@@exempel.se" />
        </div>
        <div class="field">
            <label for="password">Lösenord</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn btn-primary">Logga in</button>
    </form>

    <div class="divider"><span>eller</span></div>

    @* ---- Passwordless (magic link) ---- *@
    <section class="magic">
        <h2 class="magic-title">Logga in utan lösenord</h2>
        <p class="magic-help">Vi skickar en inloggningslänk till din e-post.</p>

        <form method="post" action="/auth/magic-link" class="auth-form">
            <AntiforgeryToken />
            <div class="field">
                <input name="email" type="email" required placeholder="namn@@exempel.se" aria-label="E-post för inloggningslänk" />
            </div>
            <button type="submit" class="btn btn-outline">Skicka länk</button>
        </form>

        @if (Sent == "1")
        {
            <div class="alert alert-info">
                Om adressen finns hos oss skickas en inloggningslänk dit.
            </div>
        }

        @* Development convenience: the server echoes the token so the flow is
           testable without a real email provider. *@
        @if (!string.IsNullOrEmpty(DevToken))
        {
            <a class="btn btn-dark" href="@($"/auth/magic-link/consume?token={DevToken}")">
                Klicka här för att logga in (dev)
            </a>
        }
    </section>

    <p class="auth-alt">
        Ny här? <a href="/registrera">Skapa en förening</a>
    </p>
</div>
