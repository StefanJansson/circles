@page "/cirklar/{Id:guid}/uppgifter"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject CirclesQueryService Circles
@inject ContentService Content
@inject AuthenticationStateProvider AuthState

<PageTitle>Uppgifter · Circles</PageTitle>

@* ── Task row + its sub-tasks (defined first so it can be used below) ───────── *@
@{
    RenderFragment<CirclesTaskDto> RenderTask = task =>@<li class="task-item">
        <div class="task-row @(task.IsCompleted ? "task-done" : "")">
            <span class="task-checkbox @(task.IsCompleted ? "task-checked" : "")"
                  @onclick="() => ToggleTask(task.Id)">@(task.IsCompleted ? "✓" : "")</span>
            <div class="task-body" @onclick="() => ToggleTask(task.Id)">
                <span class="task-title">@task.Title</span>
                <span class="task-sub-meta">
                    @if (task.DueDate.HasValue)
                    {
                        <span class="task-due">Förfaller @task.DueDate.Value.ToString("d MMM")</span>
                    }
                    @if (task.AssignedToName is not null)
                    {
                        <span class="task-assignee">👤 @task.AssignedToName</span>
                    }
                </span>
            </div>
            <span class="task-creator">@task.CreatedByName</span>
        </div>

        @{
            var subs = SubTasksOf(task.Id).ToList();
        }
        @if (subs.Count > 0)
        {
            <ul class="subtask-list">
                @foreach (var s in subs)
                {
                    <li class="task-row task-subrow @(s.IsCompleted ? "task-done" : "")">
                        <span class="task-checkbox @(s.IsCompleted ? "task-checked" : "")"
                              @onclick="() => ToggleTask(s.Id)">@(s.IsCompleted ? "✓" : "")</span>
                        <div class="task-body" @onclick="() => ToggleTask(s.Id)">
                            <span class="task-title">@s.Title</span>
                            @if (s.AssignedToName is not null)
                            {
                                <span class="task-assignee">👤 @s.AssignedToName</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }

        @if (!task.IsCompleted)
        {
            @if (_subtaskParentId == task.Id)
            {
                <div class="subtask-form">
                    <input type="text" @bind="_subtaskTitle" placeholder="Deluppgift…" maxlength="200" />
                    <select @bind="_subtaskAssignee">
                        <option value="">— Ingen ansvarig —</option>
                        @foreach (var m in _members)
                        {
                            <option value="@m.PersonId">@m.FullName</option>
                        }
                    </select>
                    @if (_subtaskError is not null)
                    {
                        <p class="field-error">@_subtaskError</p>
                    }
                    <div class="subtask-form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => CreateSubtask(task.Id)" disabled="@_subtaskSaving">
                            @(_subtaskSaving ? "Sparar…" : "Lägg till")
                        </button>
                        <button class="btn btn-outline btn-sm" @onclick="() => ToggleSubtaskForm(task.Id)">Avbryt</button>
                    </div>
                </div>
            }
            else
            {
                <button class="subtask-add-btn" @onclick="() => ToggleSubtaskForm(task.Id)">+ Deluppgift</button>
            }
        }
    </li>;
}

<header class="page-header">
    <a class="back-link" href="/cirklar/@Id">← Tillbaka</a>
</header>

@if (_circle is not null)
{
    <div class="circle-detail-head">
        <h1>@_circle.Name</h1>
    </div>

    <nav class="circle-tabs">
        <a class="circle-tab" href="/cirklar/@Id">Medlemmar</a>
        <a class="circle-tab" href="/cirklar/@Id/diskussioner">Diskussioner</a>
        <a class="circle-tab" href="/cirklar/@Id/omrostningar">Omröstningar</a>
        <a class="circle-tab circle-tab-active" href="/cirklar/@Id/uppgifter">Uppgifter</a>
    </nav>
}

@if (_error is not null)
{
    <p class="alert alert-error" role="alert">@_error</p>
}
else if (_loading)
{
    <div class="center-pad"><div class="spinner"></div></div>
}
else
{
    <!-- Ny uppgift -->
    <section class="content-section">
        <button class="btn btn-outline btn-sm" @onclick="ToggleForm">
            @(_showForm ? "Avbryt" : "+ Ny uppgift")
        </button>

        @if (_showForm)
        {
            <div class="compose-card">
                <div class="field">
                    <label>Titel</label>
                    <input type="text" @bind="_newTitle" placeholder="Vad ska göras?" maxlength="200" />
                </div>
                <div class="field">
                    <label>Beskrivning (valfritt)</label>
                    <textarea @bind="_newDescription" rows="3" placeholder="Mer detaljer…" maxlength="2000"></textarea>
                </div>
                <div class="field">
                    <label>Förfallodatum (valfritt)</label>
                    <input type="date" @bind="_newDueDate" />
                </div>
                <div class="field">
                    <label>Ansvarig (valfritt)</label>
                    <select @bind="_newAssignee">
                        <option value="">— Ingen —</option>
                        @foreach (var m in _members)
                        {
                            <option value="@m.PersonId">@m.FullName</option>
                        }
                    </select>
                </div>
                @if (_formError is not null)
                {
                    <p class="field-error">@_formError</p>
                }
                <button class="btn btn-primary btn-sm" @onclick="CreateTask" disabled="@_saving">
                    @(_saving ? "Sparar…" : "Lägg till uppgift")
                </button>
            </div>
        }
    </section>

    <!-- Lista -->
    <section class="content-section">
        @{
            var topLevel  = _tasks?.Where(t => t.ParentTaskId is null).ToList() ?? new();
            var pending   = topLevel.Where(t => !t.IsCompleted).ToList();
            var completed = topLevel.Where(t =>  t.IsCompleted).ToList();
        }

        <h2 class="section-label">Öppna (@pending.Count)</h2>

        @if (pending.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">🎉</span>
                <p class="empty-title">Inga öppna uppgifter</p>
                <p class="empty-help">Bra jobbat!</p>
            </div>
        }
        else
        {
            <ul class="task-list">
                @foreach (var t in pending)
                {
                    @RenderTask(t)
                }
            </ul>
        }

        @if (completed.Count > 0)
        {
            <h2 class="section-label" style="margin-top:24px">Klara (@completed.Count)</h2>
            <ul class="task-list task-list-done">
                @foreach (var t in completed)
                {
                    @RenderTask(t)
                }
            </ul>
        }
    </section>
}
