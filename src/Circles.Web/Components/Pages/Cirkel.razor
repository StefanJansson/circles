@page "/cirklar/{Id:guid}"
@using Circles.Domain.Enums
@attribute [Authorize]
@rendermode InteractiveServer
@inherits CirkelBase

<PageTitle>@(_circle?.Name ?? "Cirkel") · Circles</PageTitle>

<header class="page-header">
    <a class="back-link" href="/hem">← Tillbaka</a>
</header>

@if (_error is not null)
{
    <p class="alert alert-error" role="alert">@_error</p>
}
else if (_loading)
{
    <div class="center-pad"><div class="spinner"></div></div>
}
else if (_circle is null)
{
    <div class="empty-state">
        <p class="empty-title">Cirkeln kunde inte visas</p>
        <p class="empty-help">Du kanske inte har åtkomst till den här cirkeln.</p>
    </div>
}
else
{
    <div class="circle-detail-head">
        <h1>@_circle.Name</h1>
        <div class="chips">
            <span class="chip">@Labels.Circle(_circle.Type)</span>
            <span class="chip @(_circle.AccessKind == "Direct" ? "chip-direct" : "chip-derived")">
                @Labels.Access(_circle.AccessKind) åtkomst
            </span>
        </div>
    </div>

    <!-- Tab-navigering -->
    <nav class="circle-tabs">
        <a class="circle-tab circle-tab-active" href="/cirklar/@Id">Medlemmar</a>
        @if (_enabledModules.Contains(ModuleType.Discussions))
        {
            <a class="circle-tab" href="/cirklar/@Id/diskussioner">Diskussioner</a>
        }
        @if (_enabledModules.Contains(ModuleType.Polls))
        {
            <a class="circle-tab" href="/cirklar/@Id/omrostningar">Omröstningar</a>
        }
        @if (_enabledModules.Contains(ModuleType.Tasks))
        {
            <a class="circle-tab" href="/cirklar/@Id/uppgifter">Uppgifter</a>
        }
        @if (_enabledModules.Contains(ModuleType.Events))
        {
            <a class="circle-tab" href="/cirklar/@Id/handelser">Händelser</a>
        }
        @if (_enabledModules.Contains(ModuleType.Announcements))
        {
            <a class="circle-tab" href="/cirklar/@Id/meddelanden">Meddelanden</a>
        }
    </nav>

    <section>
        <h2 class="section-label">Medlemmar (@(_members?.Count ?? 0))</h2>

        @if (_members is null || _members.Count == 0)
        {
            <div class="empty-state">
                <p class="empty-title">Inga aktiva medlemmar</p>
            </div>
        }
        else
        {
            <ul class="member-list">
                @foreach (var m in _members)
                {
                    <li class="member-row">
                        <span class="avatar avatar-sm">@Labels.Initials(m.FullName)</span>
                        <span class="member-name">@m.FullName</span>
                        <span class="member-role">@Labels.Role(m.Role)</span>
                    </li>
                }
            </ul>
        }
    </section>
}
